# Firebase & GCP
FIREBASE_CREDENTIALS=your_firebase_service_account_json_base64_encoded_here
GCS_BUCKET=clipflow-videos-prod
GCS_PROJECT_ID=your-gcp-project-id

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Backend Config
BACKEND_PORT=8000
BACKEND_ENV=development
REDIS_URL=redis://redis:6379/0
DATABASE_URL=firestore://

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","projectId":"..."}

# Processing Config
MAX_VIDEO_SIZE_MB=2048
PROCESSING_TIMEOUT_SECONDS=300
FFMPEG_PATH=ffmpeg
MEDIAPIPE_MODELS_PATH=/app/models

# Stripe (Optional - Phase 2)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Logging
LOG_LEVEL=INFO
